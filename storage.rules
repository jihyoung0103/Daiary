rules_version = '2';

// Firebase Storage 보안 규칙
// 적용: Firebase 콘솔 → Storage → Rules 에 붙여넣기 (또는 firebase CLI로 배포)
//
// 정책: 로그인한 사용자는 본인 경로(users/{uid}/**)만 읽고 쓸 수 있다.
//   - 프로필 사진:  users/{uid}/profile.jpg
//   - 일기 사진:    users/{uid}/diaries/{date}/{uuid}.jpg
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
